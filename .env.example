# Copy this file to .env and add your own API credentials.
PORT=3000
PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# To use Anthropic instead, set PROVIDER=anthropic and provide your own key:
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
